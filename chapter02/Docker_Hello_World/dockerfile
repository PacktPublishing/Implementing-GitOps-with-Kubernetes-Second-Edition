# Uses the slim, officially maintained Python 3.14 base image.
FROM python:3.14-slim

# Sets the working directory for all subsequent commands and the application startup.
WORKDIR /usr/src/app

# Copies only the dependency list first so Docker can cache this build step.
COPY requirements.txt .

# Installs the Python dependencies without retaining pip's unnecessary download cache.
RUN python -m pip install --no-cache-dir -r requirements.txt

# Copies the application code into the image's working directory.
COPY . .

# Creates an unprivileged user with a dedicated home directory for the application.
RUN useradd --create-home appuser

# Runs all subsequent instructions and the container process without root privileges.
USER appuser

# Documents that the application listens on TCP port 80 without publishing the port itself.
EXPOSE 80

# Sets the NAME environment variable to World; the current app.py does not use it yet.
ENV NAME=World

# Starts the Flask application with Python when the container launches.
CMD ["python", "app.py"]
