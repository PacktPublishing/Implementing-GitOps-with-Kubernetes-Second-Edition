# Helm
charts/
Chart.lock

# Docker
.DS_Store
# Kubernetes
*.env
# macOS
#########################################
### kubara gitignore ###
# kubara program
kubara_*amd64*
kubara_*arm64*
kubara
# Terraform
# Local .terraform directories
**/.terraform/
# State files
*.tfstate
*.tfstate.*
# Env helper scripts (optional, but often local only)
**/set-env*.sh
**/set-env*.ps1
# Terraform lock file (only ignore if using providers globally)
.terraform.lock.hcl
# Crash logs
crash.log
crash.*.log
# Terraform-generated files
generated_backend.tf
*.hprof
runtime_settings.properties
# Helm charts and lock files
**/charts/
**/Chart.lock
**/*.tgz
# Secrets
# Generic
**/secrets
/secrets
# Specific
launchers/demo-e2e/edc-config.properties
.env
.kubara/
.local/
# Logs
*.log
test/
# OS & Editor Artifacts
# Visual Studio
.vs/
.vscode/
# IntelliJ
.idea/
*.iml
*.ipr
*.iws
*/out/
out/
# Archives / Packaging
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Go (if you use Go modules or compiled binaries)
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
# Go build output
/go.sum
/go.mod
bin/
**/*.tfplan
**/azureplan
**/awsplan
**/tfplan
**/plan.json
**/terraform.tfvars

# --- Chapter 8/9 additions ---
# Editor / tooling leftovers (e.g. `sed -i.bak` in the chapter READMEs)
*.bak
*.orig
*~
# Kubeconfig files
kubeconfig
kubeconfig.*
*.kubeconfig
# Terraform / OpenTofu: lock files are not committed in this book repo
**/.terraform.lock.hcl
**/*.auto.tfvars
# Override files: Tofu Controller writes the real backend to backend_override.tf
**/override.tf
**/*_override.tf
